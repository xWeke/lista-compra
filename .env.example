# Copia este fichero a .env y rellena los valores (Supabase → Project Settings → API Keys).
# .env NO se sube a git. En GitHub Pages, estos valores se configuran como secrets del repo.
# Ambas son públicas por diseño (la seguridad la da RLS); NUNCA pongas aquí la service_role / secret key.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=
